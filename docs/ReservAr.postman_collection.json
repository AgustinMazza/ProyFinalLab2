{
  "info": {
    "name": "ReservAr API (JWT)",
    "description": "Ejecutar en orden. Los pasos 1 y 2 guardan los tokens en variables de la colección. Requiere la app corriendo en baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login SuperAdmin (200 + token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "const datos = pm.response.json();",
              "pm.test(\"Devuelve token\", function () { pm.expect(datos.token).to.be.a(\"string\").and.not.empty; });",
              "pm.collectionVariables.set(\"tokenSuperAdmin\", datos.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"superadmin@reservar.com\",\n  \"password\": \"Super123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Guarda el token en la variable tokenSuperAdmin."
      }
    },
