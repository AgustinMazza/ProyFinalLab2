    {
      "name": "4. Mi perfil (200, cualquier rol)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/perfil",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "perfil"]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenSuperAdmin}}",
              "type": "string"
            }
          ]
        }
      }
    },
