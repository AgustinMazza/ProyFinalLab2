@{
  var esSuperAdmin = User.IsInRole(Roles.SuperAdmin);
  ViewData["Title"] = esSuperAdmin ? "Negocios" : "Mis negocios";
}

<style>
  [v-cloak] {
    display: none;

  }
</style>



@Html.AntiForgeryToken()

<div id="app" v-cloak data-es-superadmin="@(esSuperAdmin ? "true" : "false")">
  <h2 class="mb-4">@ViewData["Title"]</h2>

  <div class="d-flex justify-content-between mb-3">
    <input type="text" class="form-control w-50" :placeholder="esSuperAdmin ? 'Buscar por nombre, dirección o dueño' : 'Buscar por nombre o dirección'" v-model="buscar"
          v-on:input="buscarConPausa" />
    <div>
      @if (esSuperAdmin)
      {
        <a asp-controller="Peticiones" asp-action="Index" class="btn btn-superadmin me-2">Peticiones</a>
      }
      <button class="btn btn-primary" v-on:click="nuevo">Nuevo negocio</button>
    </div>
  </div>

  <div v-if="mostrarForm" class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">{{ form.idNegocio === 0 ? 'Nuevo negocio' : 'Editar negocio' }}</h5>

      <div v-if="errores.length > 0" class="alert alert-danger">
        <ul class="mb-0">
          <li v-for="e in errores">{{ e }}</li>
        </ul>
      </div>

      <form v-on:submit.prevent="guardar">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control" maxlength="150" v-model="form.nombre" />
          </div>
          <div class="col-md-6">
            <label class="form-label">Categoria</label>
            <select class="form-select" v-model="form.idCategoria">
              <option :value="0" disabled>Elegi una categoria</option>
              <option v-for="c in categorias" :key="c.idCategoria" :value="c.idCategoria">{{ c.nombre }}
              </option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Dirección</label>
            <input type="text" class="form-control" maxlength="200" v-model="form.direccion" />
          </div>
          <div class="col-md-6">
            <label class="form-label">Ciudad</label>
            <input type="text" class="form-control" maxlength="100" v-model="form.ciudad" />
          </div>
          <div class="col-md-6">
            <label class="form-label">Teléfono</label>
            <input type="text" class="form-control" maxlength="30" v-model="form.telefono" />
          </div>
                    <div class="col-md-6" v-if="esSuperAdmin">
            <label class="form-label">Dueño</label>
            <div v-if="form.idUsuario > 0 && !cambiandoDuenio" class="input-group">
              <input type="text" class="form-control" :value="duenioNombre" readonly />
              <button type="button" class="btn btn-outline-secondary" v-on:click="cambiarDuenio">Cambiar</button>
            </div>

            <div v-else>
              <input type="text" class="form-control" autocomplete="off"
                     placeholder="Escribí nombre o email y elegí de la lista" v-model="duenioBuscar"
                     v-on:input="buscarDueniosConPausa" v-on:focus="buscarDuenios" />
              <div class="list-group" v-if="duenioResultados.length > 0">
                <button type="button" class="list-group-item list-group-item-action" v-for="d in duenioResultados"
                        :key="d.idUsuario" v-on:click="elegirDuenio(d)">
                  {{ d.nombreCompleto }} <small class="text-muted">{{ d.email }}</small>
                </button>
              </div>
            </div>
          </div>

          <div class="col-12" v-if="form.idNegocio > 0">
            <label class="form-label">Imágenes del negocio <small class="text-muted">({{ imagenes.length }}/10)</small></label>

            <div class="row g-2 mb-2">
              <div class="col-6 col-md-3" v-for="img in imagenes" :key="img.idImagenNegocio">
                <div class="card h-100">
                  <img :src="img.ruta" class="card-img-top" style="height: 100px; object-fit: cover" alt="" />
                  <div class="card-body p-1 d-flex flex-column gap-1">
                    <span v-if="img.esPortada" class="badge bg-primary">Portada</span>
                    <button v-else type="button" class="btn btn-sm btn-outline-primary py-0"
                            v-on:click="hacerPortada(img)">Hacer portada</button>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0"
                            v-on:click="eliminarImagen(img)">Eliminar</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="input-group" v-if="imagenes.length < 10">
              <input type="file" ref="archivosImagenes" class="form-control" multiple
                     accept=".jpg,.jpeg,.png,.webp" />
              <button type="button" class="btn btn-outline-primary" v-on:click="subirImagenes">Subir</button>
            </div>
            <div class="form-text">JPG, PNG o WEBP, hasta 3 MB cada una. Podés elegir varias a la vez.</div>
          </div>
          <div class="col-12">
            <label class="form-label">Descripción</label>
            <textarea class="form-control" rows="3" maxlength="500" v-model="form.descripcion"></textarea>
          </div>
        </div>

        <div class="mt-3">
          <button type="submit" class="btn btn-success">Guardar</button>
          <button type="button" class="btn btn-secondary" v-on:click="cancelar">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th>Portada</th>
        <th>Nombre</th>
        <th>Categoria</th>
        <th>Dirección</th>
        <th v-if="esSuperAdmin">Dueño</th>
        <th>Estado</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <tr v-for="n in negocios" :key="n.idNegocio" :class="{ 'table-secondary': !n.activo }">
        <td>
      <img v-if="n.imagenes && n.imagenes.length" :src="n.imagenes[0]"
          style="width:60px; height:40px; object-fit:cover" class="rounded" />
          </td>
        <td>{{ n.nombre }}</td>
        <td>{{ n.categoria }}</td>
        <td>{{ n.direccion }}, {{ n.ciudad }}</td>
        <td v-if="esSuperAdmin">{{ n.duenio }}</td>
        <td>
          <span class="badge" :class="n.activo ? 'bg-success' : 'bg-secondary'">
            {{ n.activo ? 'Activo' : 'Inactivo' }}
          </span>
        </td>
        <td class="text-end">
          <button class="btn btn-sm btn-outline-primary" v-on:click="editar(n)">Editar</button>
          <a :href="'/Canchas/Index/' + n.idNegocio" class="btn btn-sm btn-outline-secondary">Canchas</a>
          <button v-if="n.activo" class="btn btn-sm btn-outline-danger" v-on:click="baja(n)">Dar de
            baja</button>
            <button v-else class="btn btn-sm btn-outline-success" v-on:click="reactivar(n)">Reactivar</button>
          </td>
        </tr>
        <tr v-if="negocios.length === 0">
          <td :colspan="esSuperAdmin ? 7 : 6" class="text-center text-muted">No hay negocios para mostrar</td>
        </tr>
      </tbody>
    </table>

    <nav v-if="totalPaginas > 1">
      <ul class="pagination">
        <li class="page-item" :class="{ disabled: pagina === 1 }">
          <button class="page-link" v-on:click="irAPagina(pagina - 1)">Anterior</button>
        </li>
        <li v-for="n in totalPaginas" :key="n" class="page-item" :class="{ active: n === pagina }">
          <button class="page-link" v-on:click="irAPagina(n)">{{ n }}</button>
        </li>
        <li class="page-item" :class="{ disabled: pagina === totalPaginas }">
          <button class="page-link" v-on:click="irAPagina(pagina + 1)">Siguiente</button>
        </li>
      </ul>
    </nav>
  </div>

  @section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/vue@3.5.13/dist/vue.global.prod.js"></script>
    <script src="~/js/negocios.js" asp-append-version="true"></script>
  }