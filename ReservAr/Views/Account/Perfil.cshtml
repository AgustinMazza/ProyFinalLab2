@model ReservAr.Models.Usuario
@{
  ViewData["Title"] = "Mi perfil";
}

<div class="row justify-content-center">
  <div class="col-md-6" id="panelPerfil">
    <h2 class="mb-4">Mi perfil</h2>

    @if (TempData["Mensaje"] != null)
    {
      <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
      <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="text-center mb-4">
      @if (!string.IsNullOrEmpty(Model.Avatar))
      {
        <img src="@Model.Avatar" alt="Avatar" class="rounded-circle"
             style="width:150px; height:150px; object-fit:cover;" />
      }
      else
      {
        <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center"
             style="width:150px; height:150px; font-size:3rem;">
          @Model.Nombre[0]
        </div>
      }
    </div>

    <form asp-action="CambiarAvatar" method="post" enctype="multipart/form-data" class="mb-4">
      <div class="input-group">
        <input type="file" name="archivo" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
        <button type="submit" class="btn btn-primary">Cambiar avatar</button>
      </div>
    </form>

    <dl class="row">
      <dt class="col-sm-4">Nombre</dt>
      <dd class="col-sm-8">@Model.Nombre @Model.Apellido</dd>

      <dt class="col-sm-4">Email</dt>
      <dd class="col-sm-8">@Model.Email</dd>

      <dt class="col-sm-4">Teléfono</dt>
      <dd class="col-sm-8">@(Model.Telefono ?? "No cargado")</dd>

      <dt class="col-sm-4">Miembro desde</dt>
      <dd class="col-sm-8">@Model.FechaAlta.ToString("dd/MM/yyyy")</dd>
    </dl>
    <hr />

    <div class="d-flex gap-2 mb-3">
      <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#formDatos">
        Editar mis datos
      </button>
      <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#formPassword">
        Cambiar contraseña
      </button>
    </div>

    <div class="collapse" id="formDatos" data-bs-parent="#panelPerfil">
      <div class="card card-body mb-4">
        <h4 class="mb-3">Editar mis datos</h4>
        <form asp-action="EditarPerfil" method="post">
          <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input type="text" name="Nombre" value="@Model.Nombre" class="form-control" />
          </div>
          <div class="mb-3">
            <label class="form-label">Apellido</label>
            <input type="text" name="Apellido" value="@Model.Apellido" class="form-control" />
          </div>
          <div class="mb-3">
            <label class="form-label">Teléfono</label>
            <input type="text" name="Telefono" value="@Model.Telefono" class="form-control" />
          </div>
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </form>
      </div>
    </div>

    <div class="collapse" id="formPassword" data-bs-parent="#panelPerfil">
      <div class="card card-body mb-4">
        <h4 class="mb-3">Cambiar contraseña</h4>
        <form asp-action="CambiarPassword" method="post">
          <div class="mb-3">
            <label class="form-label">Contraseña actual</label>
            <input type="password" name="ActualPassword" class="form-control" />
          </div>
          <div class="mb-3">
            <label class="form-label">Contraseña nueva</label>
            <input type="password" name="NuevaPassword" class="form-control" />
          </div>
          <div class="mb-3">
            <label class="form-label">Repetir contraseña nueva</label>
            <input type="password" name="ConfirmarPassword" class="form-control" />
          </div>
          <div class="form-check mb-3">
            <input type="checkbox" class="form-check-input ver-passwords" id="verPasswords" />
            <label class="form-check-label" for="verPasswords">Mostrar contraseñas</label>
          </div>
          <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
        </form>
      </div>
    </div>