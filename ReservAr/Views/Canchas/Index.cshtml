@{
    ViewData["Title"] = "Canchas";
}

<style>
    [v-cloak] {
        display: none;
    }
</style>

@Html.AntiForgeryToken()

<div id="app" v-cloak data-id-negocio="@ViewBag.IdNegocio">
    <h2 class="mb-1">Canchas</h2>
    <p class="text-muted">@ViewBag.NegocioNombre</p>

    <div class="d-flex justify-content-between mb-3">
        <a asp-controller="Negocios" asp-action="Index" class="btn btn-outline-secondary">Volver a negocios</a>
        <button class="btn btn-primary" v-on:click="nuevaCancha">Nueva cancha</button>
    </div>

    <div v-if="mostrarForm" class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">{{ form.idRecurso === 0 ? 'Nueva cancha' : 'Editar cancha' }}</h5>

            <div v-if="errores.length > 0" class="alert alert-danger">
                <ul class="mb-0">
                    <li v-for="e in errores">{{ e }}</li>
                </ul>
            </div>

            <form v-on:submit.prevent="guardarCancha">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" maxlength="100" v-model="form.nombre" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Duración del turno (minutos)</label>
                        <input type="number" class="form-control" min="15" max="120" step="15"
                               v-model.number="form.duracionMin" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" rows="2" maxlength="300" v-model="form.descripcion"></textarea>
                    </div>

                    <template v-if="form.idRecurso === 0">
                        <div class="col-12">
                            <h6 class="mb-0">Tarifas base (precio por hora)</h6>
                            <small class="text-muted">Después podés editarlas o agregar más desde la cancha.</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mañana (08:00 a 14:00)</label>
                            <input type="number" class="form-control" min="1" step="1"
                                   v-model.number="form.precioManana" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Tarde (14:00 a 18:00)</label>
                            <input type="number" class="form-control" min="1" step="1"
                                   v-model.number="form.precioTarde" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Noche (18:00 a 24:00)</label>
                            <input type="number" class="form-control" min="1" step="1"
                                   v-model.number="form.precioNoche" />
                        </div>
                    </template>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-secondary" v-on:click="cancelarCancha">Cancelar</button>
                </div>
            </form>
        </div>
    </div>

    <div v-if="canchas.length === 0" class="alert alert-info">Este negocio todavía no tiene canchas</div>

    <div v-for="c in canchas" :key="c.idRecurso" class="card mb-4" :class="{ 'border-secondary': !c.activo }">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>{{ c.nombre }}</strong>
                <span class="badge ms-2" :class="c.activo ? 'bg-success' : 'bg-secondary'">
                    {{ c.activo ? 'Activa' : 'Inactiva' }}
                </span>
                <small class="text-muted ms-2">Turnos de {{ c.duracionMin }} min</small>
            </div>
            <div>
                <button class="btn btn-sm btn-outline-primary" v-on:click="editarCancha(c)">Editar</button>
                <button v-if="c.activo" class="btn btn-sm btn-outline-danger" v-on:click="bajaCancha(c)">Dar de
                    baja</button>
                    <button v-else class="btn btn-sm btn-outline-success" v-on:click="reactivarCancha(c)">Reactivar</button>
                </div>
            </div>

            <div class="card-body">
                <p v-if="c.descripcion" class="text-muted">{{ c.descripcion }}</p>

                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Horarios de atención</h6>
                            <button class="btn btn-sm btn-outline-primary" v-on:click="nuevoHorario(c)">Agregar
                                horario</button>
                            </div>

                            <div v-if="formHorario && formHorario.idRecurso === c.idRecurso" class="border rounded p-3 mb-3">
                                <div v-if="erroresHorario.length > 0" class="alert alert-danger">
                                    <ul class="mb-0">
                                        <li v-for="e in erroresHorario">{{ e }}</li>
                                    </ul>
                                </div>
                                <form v-on:submit.prevent="guardarHorario">
                                    <label class="form-label">Días</label>
                                    <div class="mb-2">
                                        <div class="form-check form-check-inline" v-for="(d, i) in dias" :key="i">
                                            <input class="form-check-input" type="checkbox" :id="'dia' + c.idRecurso + '_' + i"
                                                   :value="i" v-model="formHorario.dias" />
                                            <label class="form-check-label" :for="'dia' + c.idRecurso + '_' + i">{{ d }}</label>
                                        </div>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="form-label">Desde</label>
                                            <select class="form-select" v-model="formHorario.horaDesde">
                                                <option v-for="h in horasDesde" :key="h" :value="h">{{ h }}</option>
                                            </select>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">Hasta</label>
                                            <select class="form-select" v-model="formHorario.horaHasta">
                                                <option v-for="h in horas" :key="h" :value="h">{{ h }}</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <button type="submit" class="btn btn-sm btn-success">Guardar</button>
                                        <button type="button" class="btn btn-sm btn-secondary"
                                                v-on:click="cancelarHorario">Cancelar</button>
                                    </div>
                                </form>
                            </div>

                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Día</th>
                                        <th>Horario</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="h in c.horarios" :key="h.idHorarioAtencion">
                                        <td>{{ dias[h.diaSemana] }}</td>
                                        <td>{{ h.horaDesde }} a {{ h.horaHasta }}</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    v-on:click="editarHorario(c, h)">Editar</button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    v-on:click="eliminarHorario(h)">Eliminar</button>
                                        </td>
                                    </tr>
                                    <tr v-if="c.horarios.length === 0">
                                        <td colspan="3" class="text-center text-muted">Sin horarios: la cancha no se puede
                                            reservar</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="col-lg-6">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0">Tarifas</h6>
                                    <button class="btn btn-sm btn-outline-primary" v-on:click="nuevaTarifa(c)">Agregar
                                        tarifa</button>
                                    </div>

                                    <div v-if="formTarifa && formTarifa.idRecurso === c.idRecurso" class="border rounded p-3 mb-3">
                                        <div v-if="erroresTarifa.length > 0" class="alert alert-danger">
                                            <ul class="mb-0">
                                                <li v-for="e in erroresTarifa">{{ e }}</li>
                                            </ul>
                                        </div>
                                        <form v-on:submit.prevent="guardarTarifa">
                                            <div class="row g-2">
                                                <div class="col-md-6">
                                                    <label class="form-label">Nombre</label>
                                                    <input type="text" class="form-control" maxlength="50"
                                                           v-model="formTarifa.nombre" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">Precio por hora</label>
                                                    <input type="number" class="form-control" min="1" step="1"
                                                           v-model.number="formTarifa.precioHora" />
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label">Desde</label>
                                                    <select class="form-select" v-model="formTarifa.horaDesde">
                                                        <option v-for="h in horasDesde" :key="h" :value="h">{{ h }}</option>
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label">Hasta</label>
                                                    <select class="form-select" v-model="formTarifa.horaHasta">
                                                        <option v-for="h in horas" :key="h" :value="h">{{ h }}</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <button type="submit" class="btn btn-sm btn-success">Guardar</button>
                                                <button type="button" class="btn btn-sm btn-secondary"
                                                        v-on:click="cancelarTarifa">Cancelar</button>
                                            </div>
                                        </form>
                                    </div>

                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Franja</th>
                                                <th>Precio/hora</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="t in c.tarifas" :key="t.idTarifa" :class="{ 'table-secondary': !t.activo }">
                                                <td>{{ t.nombre }}</td>
                                                <td>{{ t.horaDesde }} a {{ t.horaHasta }}</td>
                                                <td>{{ formatearPrecio(t.precioHora) }}</td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            v-on:click="editarTarifa(c, t)">Editar</button>
                                                    <button v-if="t.activo" class="btn btn-sm btn-outline-danger"
                                                            v-on:click="bajaTarifa(t)">Baja</button>
                                                    <button v-else class="btn btn-sm btn-outline-success"
                                                            v-on:click="reactivarTarifa(t)">Reactivar</button>
                                                </td>
                                            </tr>
                                            <tr v-if="c.tarifas.length === 0">
                                                <td colspan="4" class="text-center text-muted">Sin tarifas</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @section Scripts {
                    <script src="https://cdn.jsdelivr.net/npm/vue@3.5.13/dist/vue.global.prod.js"></script>
                    <script src="~/js/canchas.js" asp-append-version="true"></script>
                }