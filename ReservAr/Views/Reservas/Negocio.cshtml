
@model ReservAr.ViewModels.NegocioReservarViewModel

@{
    ViewData["Title"] = Model.Negocio.Nombre;
}

<div class="container py-4">

    <!-- Información del negocio -->
    <div class="card shadow-sm mb-4">
        @if (!string.IsNullOrEmpty(Model.Negocio.LogoUrl))
        {
            <img src="@Model.Negocio.LogoUrl"
                 class="card-img-top"
                 alt="@Model.Negocio.Nombre"
                 style="height: 260px; object-fit: cover;" />
        }

        <div class="card-body">
            <h2 class="card-title">@Model.Negocio.Nombre</h2>

            <p class="text-muted mb-2">
                @Model.Negocio.Direccion, @Model.Negocio.Ciudad
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.Negocio.Descripcion))
            {
                <p class="card-text">@Model.Negocio.Descripcion</p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Negocio.Telefono))
            {
                <p class="mb-0">
                    <strong>Teléfono:</strong> @Model.Negocio.Telefono
                </p>
            }
        </div>
    </div>

    <!-- Listado de recursos -->
    <div class="mb-3">
        <h3>Recursos disponibles</h3>
        <p class="text-muted">
            Seleccioná la cancha que querés reservar.
        </p>
    </div>

    @if (Model.Recursos == null || !Model.Recursos.Any())
    {
        <div class="alert alert-info">
            Este establecimiento todavía no tiene canchas disponibles.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

            @foreach (var recurso in Model.Recursos)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @recurso.Nombre
                            </h5>

                            <p class="card-text text-muted">
                                @(string.IsNullOrWhiteSpace(recurso.Descripcion)
                                    ? "Sin descripción disponible."
                                    : recurso.Descripcion)
                            </p>

                            <p class="mb-3">
                                <strong>Duración del turno:</strong>
                                @recurso.DuracionMin minutos
                            </p>

                            <div class="mt-auto">
                                <a asp-controller="Reservas"
                                   asp-action="Detalles"
                                   asp-route-id="@recurso.IdRecurso"
                                   class="btn btn-primary w-100">

                                    Seleccionar cancha

                                </a>
                            </div>

                        </div>

                    </div>
                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Volver al catálogo

        </a>
    </div>

</div>
