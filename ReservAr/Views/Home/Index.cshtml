@{
  ViewData["Title"] = "Inicio";
}

<style>
  [v-cloak] {
    display: none;
  }
</style>

<div id="app" v-cloak>
  <div class="text-center py-4">
    <h1 class="display-5">Reservá tu cancha</h1>
    <p class="text-muted">Buscá un complejo, elegí cancha y horario.</p>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-md-8">
      <input type="text" class="form-control" placeholder="Buscar por nombre o dirección" v-model="buscar"
             v-on:input="buscarConPausa" />
    </div>
    <div class="col-md-4">
      <select class="form-select" v-model="idCategoria" v-on:change="filtrar">
        <option :value="0">Todas las categorías</option>
        <option v-for="c in categorias" :key="c.idCategoria" :value="c.idCategoria">{{ c.icono }} {{ c.nombre }}
        </option>
      </select>
    </div>
  </div>

  <div v-if="error" class="alert alert-danger">{{ error }}</div>

  <p class="text-muted small">{{ total }} {{ total === 1 ? 'resultado' : 'resultados' }}</p>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" :class="{ 'opacity-50': cargando }">
    <div class="col" v-for="n in negocios" :key="n.idNegocio">
      <div class="card h-100 shadow-sm">
        <div class="position-relative">
          <img v-if="imagenActual(n)" :src="imagenActual(n)" class="card-img-top" alt=""
               style="height: 160px; object-fit: cover" />
          <div v-else class="bg-light d-flex align-items-center justify-content-center text-muted display-4"
               style="height: 160px">
            {{ n.nombre.charAt(0) }}
          </div>

          <div v-if="n.imagenes && n.imagenes.length > 1"
               class="position-absolute bottom-0 start-50 translate-middle-x mb-2 d-flex gap-1">
            <span v-for="(img, i) in n.imagenes" :key="i" class="rounded-circle" style="width:8px; height:8px;"
                  :class="i === tick % n.imagenes.length ? 'bg-white' : 'bg-white bg-opacity-50'"></span>
          </div>
        </div>
        <div class="card-body d-flex flex-column">
          <span class="badge bg-primary align-self-start mb-2">{{ n.categoria }}</span>
          <div class="d-flex justify-content-between align-items-start">
            <h5 class="card-title">{{ n.nombre }}</h5>
            <span v-if="n.categoriaIcono" class="fs-3 ms-2">{{ n.categoriaIcono }}</span>
          </div>
          <p class="card-text text-muted small mb-1">{{ n.direccion }}, {{ n.ciudad }}</p>
          <p class="card-text small">{{ n.descripcion }}</p>
          <div class="mt-auto d-flex justify-content-between align-items-center">
            <small class="text-muted">{{ n.cantidadRecursos }} para reservar</small>
            <a :href="'/Reservas/Negocio/' + n.idNegocio" class="btn btn-sm btn-primary">
              Ver y reservar
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <p v-if="!cargando && negocios.length === 0" class="text-center text-muted mt-4">
    No encontramos complejos con esos filtros
  </p>

  <nav v-if="totalPaginas > 1" class="mt-4">
    <ul class="pagination justify-content-center">
      <li class="page-item" :class="{ disabled: pagina === 1 }">
        <button class="page-link" v-on:click="irAPagina(pagina - 1)">Anterior</button>
      </li>
      <li v-for="n in totalPaginas" :key="n" class="page-item" :class="{ active: n === pagina }">
        <button class="page-link" v-on:click="irAPagina(n)">{{ n }}</button>
      </li>
      <li class="page-item" :class="{ disabled: pagina === totalPaginas }">
        <button class="page-link" v-on:click="irAPagina(pagina + 1)">Siguiente</button>
      </li>
    </ul>
  </nav>
</div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/vue@3.5.13/dist/vue.global.prod.js"></script>
  <script src="~/js/home.js" asp-append-version="true"></script>
}